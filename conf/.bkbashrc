alias ll='ls -l'

command_exists() {
	type "$1" &> /dev/null ;
}
if command_exists colordiff ; then
	alias diff=colordiff
fi

PS1='\[\e[1;30m\][\[\e[m\]\[\e[1;35m\]\u@\h\[\e[m\] \[\e[1;34m\]\W\[\e[m\]\[\e[1;30m\]]\[\e[m\]\[\e[1;30m\]\$\[\e[m\] '
VISUAL=vim
EDITOR=$VISUAL
export EDITOR VISUAL PS1

# ─── Copilot premium-interaction quota ────────────────────────────────────────
# Print cached quota on shell start; refresh in the background so the next
# shell sees fresh numbers. Cache is shared across all shells/tmux panes.
_copilot_quota_cache="$HOME/.cache/copilot-quota.json"
_copilot_quota_ttl=900  # 15 min

_copilot_quota_refresh_bg() {
	(
		mkdir -p "$(dirname "$_copilot_quota_cache")"
		local tmp
		tmp=$(mktemp "${_copilot_quota_cache}.XXXXXX") || exit
		if gh api /copilot_internal/user > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
			mv "$tmp" "$_copilot_quota_cache"
		else
			rm -f "$tmp"
		fi
	) &>/dev/null &
	disown $! 2>/dev/null || true
}

copilot-quota() {
	command_exists gh && command_exists jq || return 0

	local now age=0 stale=true
	now=$(date +%s)
	if [ -f "$_copilot_quota_cache" ]; then
		local mtime
		mtime=$(stat -f %m "$_copilot_quota_cache" 2>/dev/null)
		if [ -n "$mtime" ]; then
			age=$((now - mtime))
			[ "$age" -lt "$_copilot_quota_ttl" ] && stale=false
		fi
	fi
	$stale && _copilot_quota_refresh_bg
	[ -f "$_copilot_quota_cache" ] || return 0

	local entitlement remaining reset
	read -r entitlement remaining reset < <(jq -r '
		[
			(.quota_snapshots.premium_interactions.entitlement // 0),
			(.quota_snapshots.premium_interactions.remaining // 0),
			(.quota_reset_date // "?")
		] | @tsv
	' "$_copilot_quota_cache" 2>/dev/null | tr '\t' ' ')
	[ -z "$entitlement" ] && return 0

	local color reset_color=$'\033[0m'
	if [ "$remaining" -le 0 ] 2>/dev/null; then
		color=$'\033[31m'
	elif [ "$entitlement" -gt 0 ] 2>/dev/null && \
	     [ $((remaining * 5)) -lt "$entitlement" ] 2>/dev/null; then
		color=$'\033[33m'
	else
		color=$'\033[32m'
	fi

	local age_str
	if   [ "$age" -lt 60 ];    then age_str="${age}s ago"
	elif [ "$age" -lt 3600 ];  then age_str="$((age / 60))m ago"
	elif [ "$age" -lt 86400 ]; then age_str="$((age / 3600))h ago"
	else                            age_str="$((age / 86400))d ago"
	fi

	printf "%sCopilot premium: %s/%s left (resets %s)%s [%s]\n" \
		"$color" "$remaining" "$entitlement" "$reset" "$reset_color" "$age_str"
}

case $- in *i*) copilot-quota ;; esac

